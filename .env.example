# Copy to .env for local development:  cp .env.example .env
#
# Where the backend API runs. The app itself always calls a relative /api;
# this only tells the server in front of it where to forward those calls:
#   - local dev: the Vite dev server reads it from .env (vite.config.ts)
#   - Railway:   nginx reads it at container start — set it in the frontend
#                service's Variables tab instead, e.g.
#                http://${{<backend-service>.RAILWAY_PRIVATE_DOMAIN}}:5000
# No VITE_ prefix on purpose: the browser never needs this value.
BACKEND_URL=http://localhost:5000
